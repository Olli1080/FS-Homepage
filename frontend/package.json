    "vue-router": "^4.5.0",
    "vuetify": "^3.8.0"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=4096 shx --silent rm -rf ./production && npm run build:vue && npm run build:ts && shx cp -r ./dist-ssr/dist ./production/dist-ssr",
    "build:ts": "cross-env NODE_ENV=production tsc --project tsconfig-server.json && tsc-alias -p tsconfig-server.json",
    "build:vue": "cross-env NODE_ENV=production tsx ./src/server/build.ts",
    "start": "npm run start:tsx",
    "start:tsx": "cross-env NODE_ENV=development tsx watch ./src/server/entry.ts",
    "start:prod": "cross-env NODE_ENV=production node --experimental-specifier-resolution=node ./production/src/server/entryProduction.js",
    "dev": "npx tsx watch \"./src/server/entry.ts\"",
    "dev:detailed": "cross-env DEBUG=vite-tsconfig-paths npm run dev",
    "fix": "npx eslint \"./src/**/*.{vue, ts}\" --fix",
    "lint": "npx eslint \"./src/**/*.{vue, ts}\"",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@babel/core": "^7.15.8",
    "@babel/plugin-transform-runtime": "^7.17.0",
    "@babel/preset-env": "^7.15.8",
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@intlify/eslint-plugin-vue-i18n": "^4.0.0",
    "@intlify/unplugin-vue-i18n": "^6.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/cors": "^2.8.12",
    "@types/deepmerge": "^2.2.0",
    "@types/express": "^5.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash-es": "^4.17.6",
    "@types/mime": "^3.0.1",
    "@types/netmask": "^2.0.5",
    "@types/node": "^22.0.0",
    "@types/postcss-import": "^14.0.0",
    "@types/validator": "^13.12.3",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@vue/babel-plugin-jsx": "^1.1.1",
    "autoprefixer": "^10.3.7",
    "babel-plugin-graphql-tag": "^3.3.0",
    "eslint": "^9.23.0",
    "eslint-plugin-vue": "^10.0.0",
    "glob": "^11.0.1",
    "less": "^4.1.2",
    "patch-package": "^8.0.0",
    "postcss": "^8.4.6",
    "postcss-import": "^16.1.0",
    "postcss-preset-env": "^10.1.5",
    "purgecss": "^7.0.2",
    "rollup-plugin-visualizer": "^5.8.3",
    "sass": "^1.89.2",
    "sass-embedded": "^1.89.2",
    "svg-country-flags": "^1.2.10",
    "tailwindcss": "^4.1.1",
    "tsc-alias": "^1.8.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
