    "@vue/server-renderer": "^3.5.31",
    "@vueuse/core": "^14.2.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "cross-fetch": "^4.1.0",
    "dayjs": "^1.11.20",
    "deepmerge": "^4.3.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "fs-extra": "^11.3.4",
    "graphql": "^16.13.2",
    "graphql-tag": "^2.12.6",
    "helmet": "^8.1.0",
    "jsdom": "^29.0.1",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.17.23",
    "mime": "^4.1.0",
    "netmask": "^2.0.2",
    "pinia": "^3.0.4",
    "schema-dts": "^2.0.0",
    "shx": "^0.4.0",
    "sitemap": "^9.0.1",
    "tsx": "^4.21.0",
    "validator": "^13.15.26",
    "vite": "^8.0.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vue": "^3.5.31",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.4",
    "vuetify": "^4.0.4"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=4096 shx --silent rm -rf ./production && npm run build:vue && npm run build:ts && shx cp -r ./dist-ssr/dist ./production/dist-ssr",
    "build:ts": "cross-env NODE_ENV=production tsc --project tsconfig-server.json && tsc-alias -p tsconfig-server.json",
    "build:vue": "cross-env NODE_ENV=production tsx ./src/server/build.ts",
    "start": "npm run start:tsx",
    "start:tsx": "cross-env NODE_ENV=development tsx watch ./src/server/entry.ts",
    "start:prod": "cross-env NODE_ENV=production node --experimental-specifier-resolution=node ./production/src/server/entryProduction.js",
    "dev": "npx tsx watch \"./src/server/entry.ts\"",
    "dev:detailed": "cross-env DEBUG=vite-tsconfig-paths npm run dev",
    "fix": "npx eslint \"./src/**/*.{vue, ts}\" --fix",
    "lint": "npx eslint \"./src/**/*.{vue, ts}\"",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@intlify/eslint-plugin-vue-i18n": "^4.3.0",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/netmask": "^2.0.6",
    "@types/node": "^25.5.0",
    "@types/postcss-import": "^14.0.3",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vue/babel-plugin-jsx": "^2.0.1",
    "autoprefixer": "^10.4.27",
    "babel-plugin-graphql-tag": "^3.3.0",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "glob": "^13.0.6",
    "less": "^4.6.4",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.8",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^11.2.0",
    "purgecss": "^8.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.98.0",
    "sass-embedded": "^1.98.0",
    "svg-country-flags": "^1.2.10",
    "tailwindcss": "^4.2.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.0",
    "typescript": "^6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
      "not op_mini all"
    ],
    "ssr": [
      "node 22"
    ]
  }
}
